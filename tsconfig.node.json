{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/contracts/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "vitest.config.mts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/src/i18n/index.ts",
    "src/renderer/src/i18n/locales/*.ts",
    "src/renderer/src/store/appSlice.ts",
    "src/renderer/src/store/index.ts",
    "src/renderer/src/services/LoggerService.ts",
    "src/renderer/src/services/SettingsPersistenceQueue.ts",
    "src/renderer/src/utils/formatters.ts",
    "src/renderer/src/utils/citations.ts",
    "src/renderer/src/utils/markdown.ts",
    "src/renderer/src/utils/image.ts",
    "src/renderer/src/utils/streamingProjection.ts",
    "src/renderer/src/utils/modelSearch.ts",
    "src/renderer/src/utils/modelLogos.ts",
    "src/renderer/src/utils/selection.ts",
    "src/renderer/src/context/ThemeProvider.tsx",

    "src/renderer/src/types/global.d.ts",
    "src/renderer/src/hooks/inputHistoryNavigation.ts",
    "src/renderer/src/components/chat/useMinimumDisplayDuration.ts",
    "src/renderer/src/components/chat/markdown/markdownComponents.tsx",
    "src/renderer/src/components/chat/markdown/CodeBlock.tsx",
    "src/renderer/src/components/chat/markdown/ImageViewer.tsx",
    "src/renderer/src/components/chat/markdown/MarkdownSvg.tsx",
    "src/renderer/src/components/chat/markdown/MarkdownTable.tsx",
    "src/renderer/src/components/chat/markdown/ShadowDomStyle.tsx",
    "src/renderer/src/components/chat/markdown/shadowDomStyles.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/index.tsx",
    "src/renderer/src/components/chat/markdown/CodeBlockView/constants.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/types.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/useDebouncedRender.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/useImageTools.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/useMermaid.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/GraphvizPreview.tsx",
    "src/renderer/src/components/chat/markdown/CodeBlockView/ImagePreviewLayout.tsx",
    "src/renderer/src/components/chat/markdown/CodeBlockView/MermaidPreview.tsx",
    "src/renderer/src/components/chat/markdown/CodeBlockView/PlantUmlPreview.tsx",
    "src/renderer/src/components/chat/markdown/CodeBlockView/renderSvgInShadowHost.ts",
    "src/renderer/src/components/chat/markdown/CodeBlockView/SvgPreview.tsx",
    "src/contracts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
