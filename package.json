{
  "name": "ai-chat",
  "version": "3.0.0",
  "description": "Simple multi-provider AI chat desktop application",
  "main": "./out/main/index.js",
  "author": "bariskisir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint src tests vite.config.mts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never && electron-builder --win nsis --arm64 --publish never",
    "package:win:x64": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win nsis --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never && electron-builder --linux --arm64 --publish never",
    "package:linux:x64": "npm run build && electron-builder --linux --x64 --publish never",
    "package:linux:arm64": "npm run build && electron-builder --linux --arm64 --publish never",
    "release": "npm run package:win && npm run package:linux"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@viz-js/viz": "^3.28.0",
    "dompurify": "^3.4.12",
    "electron-log": "5.4.4",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "officeparser": "^7.5.1",
    "pako": "^3.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@mozilla/readability": "^0.6.0",
    "@reduxjs/toolkit": "2.12.0",
    "@types/node": "^26.1.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "antd": "^6.5.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "i18next": "26.3.6",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.28.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-redux": "9.3.0",
    "rehype-raw": "^7.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "sass": "^1.102.0",
    "turndown": "^7.2.4",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.bariskisir.aichat",
    "productName": "AI Chat",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ai-chat-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Chat"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "AI-Chat-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "ai-chat-${version}-linux-${arch}.${ext}"
    }
  }
}
